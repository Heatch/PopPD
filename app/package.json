{
  "name": "popd",
  "version": "0.1.0",
  "private": true,
  "description": "PopPD — describe what you want, get a finished thing you can open with one click.",
  "main": "./out/main/index.js",
  "author": "Heatch",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "test": "vitest run --reporter=verbose",
    "test:integration": "cross-env POPD_INTEGRATION=1 vitest run tests/integration --testTimeout=600000",
    "test:e2e": "playwright test",
    "package": "npm run prepare:engine && npm run build && electron-builder --win --dir",
    "package:installer": "npm run prepare:engine && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@opencode/client": "2.3.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@rolldown/binding-win32-x64-msvc": "^1.2.19",
    "@swc/core": "^1.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^10.1.0",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
